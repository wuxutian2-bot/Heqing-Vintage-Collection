/**app.wxss**/
page {
  background: #f4f7f6;
  color: #1f2933;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

button {
  background: initial;
  line-height: 1.2;
  padding: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.hero {
  background: linear-gradient(135deg, #f7c948 0%, #1f7a5a 100%);
  border-radius: 8rpx;
  color: #ffffff;
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(31, 122, 90, 0.18);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-subtitle {
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 30rpx 0 18rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(31, 41, 51, 0.06);
  border-radius: 8rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 41, 51, 0.06);
}

.primary-btn,
.ghost-btn,
.danger-btn {
  align-items: center;
  border-radius: 8rpx;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  height: 88rpx;
  justify-content: center;
}

.primary-btn {
  background: #1f7a5a;
  color: #ffffff;
}

.ghost-btn {
  background: #eef5f2;
  color: #1f7a5a;
}

.danger-btn {
  background: #fff1f2;
  color: #be123c;
}

.muted {
  color: #7b8794;
}

.empty {
  color: #7b8794;
  padding: 80rpx 20rpx;
  text-align: center;
}

.field {
  background: #ffffff;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
}

.field-label {
  color: #52606d;
  display: block;
  font-size: 24rpx;
  margin-bottom: 14rpx;
}

.input,
.textarea,
.picker-value {
  color: #1f2933;
  font-size: 30rpx;
  width: 100%;
}

.textarea {
  min-height: 190rpx;
}
