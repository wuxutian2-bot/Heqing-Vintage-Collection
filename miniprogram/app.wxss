/**app.wxss**/
page {
  background: #f5f6f7;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
}

view,
text,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

button {
  background: initial;
  line-height: 1.2;
  padding: 0;
}

button[disabled] {
  opacity: 0.5;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.hero {
  background: #ffffff;
  border-bottom: 1rpx solid #e5e7eb;
  color: #1c1c1e;
  margin: -24rpx -24rpx 24rpx;
  padding: 32rpx 24rpx 28rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  color: #6b7280;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 30rpx 0 18rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
}

.primary-btn,
.ghost-btn,
.danger-btn {
  align-items: center;
  border-radius: 12rpx;
  display: flex;
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
  justify-content: center;
}

.primary-btn {
  background: #16784b;
  color: #ffffff;
}

.ghost-btn {
  background: #edf6f1;
  color: #16784b;
}

.danger-btn {
  background: #fff1f2;
  color: #be123c;
}

.muted {
  color: #6b7280;
}

.empty {
  color: #7b8794;
  padding: 80rpx 20rpx;
  text-align: center;
}

.field {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
}

.field-label {
  color: #4b5563;
  display: block;
  font-size: 24rpx;
  margin-bottom: 14rpx;
}

.input,
.textarea,
.picker-value {
  color: #1c1c1e;
  font-size: 32rpx;
  width: 100%;
}

.textarea {
  min-height: 190rpx;
}
