.cart-page { background: #f5f6f7; min-height: 100vh; padding-bottom: 150rpx; }
.cart-content { padding: 24rpx; }
.cart-head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.page-title { font-size: 40rpx; font-weight: 800; }
.muted { color: #6b7280; font-size: 24rpx; margin-top: 6rpx; }
.clear-btn { align-items: center; background: #e5484d; border-radius: 8rpx; color: #fff; display: flex; flex: 0 0 auto; font-size: 24rpx; font-weight: 700; height: 56rpx; justify-content: center; margin: 0; min-width: 112rpx; padding: 0 24rpx; }
.remove-btn { background: transparent; color: #6b7280; font-size: 24rpx; padding: 8rpx; }
.cart-list { display: flex; flex-direction: column; gap: 16rpx; }
.cart-item { background: #fff; border: 1rpx solid #e5e7eb; display: flex; gap: 20rpx; padding: 20rpx; }
.item-image { background: #eef1ef; flex: 0 0 160rpx; height: 160rpx; width: 160rpx; }
.item-main { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.item-title { font-size: 29rpx; font-weight: 700; line-height: 1.35; }
.item-price { color: #d85a18; font-size: 31rpx; font-weight: 800; margin-top: 10rpx; }
.item-bottom { align-items: center; display: flex; gap: 16rpx; justify-content: space-between; margin-top: auto; min-width: 0; }
.remove-btn { color: #9a3412; flex: 0 0 auto; margin: 0 0 0 auto; min-width: 64rpx; white-space: nowrap; }
.quantity { align-items: center; display: flex; flex: 0 0 auto; gap: 12rpx; margin: 0; }
.quantity text { display: block; min-width: 36rpx; text-align: center; }
.quantity-btn { background: #f0f2f4; border-radius: 6rpx; flex: 0 0 52rpx; font-size: 30rpx; height: 52rpx; line-height: 52rpx; margin: 0; max-width: 52rpx; min-width: 52rpx; padding: 0; width: 52rpx; }
.cart-bar { align-items: center; background: #fff; border-top: 1rpx solid #e5e7eb; bottom: 0; display: flex; left: 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); position: fixed; right: 0; }
.cart-summary { flex: 0 0 28%; min-width: 0; }
.cart-actions { align-items: center; display: grid; flex: 1 1 auto; gap: 16rpx; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); margin-left: 20rpx; min-width: 0; }
.total-price { color: #d85a18; font-size: 38rpx; font-weight: 800; }
.checkout-btn { margin: 0; width: 100%; }
.coupon-reserve { height: 88rpx; min-width: 0; }
.empty-cart { padding: 220rpx 60rpx 0; text-align: center; }
.empty-mark { align-items: center; background: #e6f2ec; border-radius: 50%; color: #16784b; display: flex; font-size: 42rpx; font-weight: 800; height: 120rpx; justify-content: center; margin: 0 auto 30rpx; width: 120rpx; }
.empty-title { font-size: 34rpx; font-weight: 750; }
.browse-btn { margin: 36rpx auto 0; width: 280rpx; }
