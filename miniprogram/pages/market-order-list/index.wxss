.orders-page { background: #f3f6f4; color: #193f34; min-height: 100vh; padding-bottom: 70rpx; }
.orders-hero { background: #153f33; color: #fff; padding: 32rpx 28rpx 29rpx; }
.hero-kicker { color: #e9c56f; font-size: 18rpx; font-weight: 800; letter-spacing: 3rpx; }
.hero-title { font-size: 40rpx; font-weight: 900; margin-top: 6rpx; }
.hero-copy { color: rgba(255,255,255,.65); font-size: 22rpx; margin-top: 9rpx; }
.status-scroll { background: #fff; border-bottom: 1rpx solid #e2e8e4; white-space: nowrap; }
.status-row { display: inline-flex; min-width: 100%; padding: 0 18rpx; }
.status-tab { color: #75827c; flex: 0 0 auto; font-size: 24rpx; padding: 24rpx 24rpx 20rpx; position: relative; }
.status-tab.active { color: #176347; font-weight: 850; }
.status-tab.active::after { background: #d7a83e; border-radius: 999rpx; bottom: 0; content: ""; height: 5rpx; left: 28%; position: absolute; width: 44%; }
.order-list { display: flex; flex-direction: column; gap: 17rpx; padding: 20rpx 22rpx; }
.order-card { background: #fff; border: 1rpx solid #e1e8e4; border-radius: 21rpx; box-shadow: 0 8rpx 24rpx rgba(29,66,53,.045); overflow: hidden; padding: 21rpx; }
.order-head { align-items: center; display: flex; justify-content: space-between; }
.platform-label { align-items: center; color: #50685d; display: flex; font-size: 21rpx; font-weight: 750; }
.platform-dot { background: #d8aa41; border-radius: 50%; height: 11rpx; margin-right: 9rpx; width: 11rpx; }
.status { background: #e8f3ed; border-radius: 999rpx; color: #287052; font-size: 20rpx; font-weight: 800; padding: 8rpx 13rpx; }
.status.attention { background: #fff2cf; color: #976914; }
.goods-row { align-items: center; display: flex; gap: 16rpx; margin-top: 18rpx; }
.goods-cover { background: #e9eeeb; border-radius: 15rpx; flex: 0 0 112rpx; height: 112rpx; width: 112rpx; }
.goods-main { flex: 1; min-width: 0; }
.goods-title { color: #203f35; display: -webkit-box; font-size: 27rpx; font-weight: 850; line-height: 1.4; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.created-text { color: #929e98; font-size: 20rpx; margin-top: 10rpx; }
.amount { color: #c45141; flex: 0 0 auto; font-size: 29rpx; font-weight: 900; }
.order-foot { border-top: 1rpx solid #edf1ef; color: #929e98; display: flex; font-size: 19rpx; justify-content: space-between; margin-top: 18rpx; padding-top: 15rpx; }
.detail-link { color: #28684f; font-weight: 750; }
.empty-state { align-items: center; color: #8a9892; display: flex; flex-direction: column; padding: 130rpx 28rpx; text-align: center; }
.empty-mark { align-items: center; background: #e5f0ea; border-radius: 24rpx; color: #267052; display: flex; font-size: 29rpx; font-weight: 900; height: 88rpx; justify-content: center; width: 88rpx; }
.empty-title { color: #27483c; font-size: 29rpx; font-weight: 850; margin-top: 20rpx; }
.empty-copy { font-size: 22rpx; line-height: 1.55; margin-top: 8rpx; }
.market-btn { background: #174c3b; border-radius: 999rpx; color: #fff; font-size: 23rpx; font-weight: 750; margin-top: 25rpx; padding: 17rpx 30rpx; }
