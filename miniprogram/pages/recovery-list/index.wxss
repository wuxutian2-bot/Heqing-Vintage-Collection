.recovery-page {
  background: #f3f6f4;
  color: #193f34;
  min-height: 100vh;
  padding: 0 22rpx 70rpx;
}

.recovery-hero {
  background: linear-gradient(145deg, #123d32 0%, #1b6b4c 100%);
  border-radius: 0 0 38rpx 38rpx;
  color: #fff;
  margin: 0 -22rpx;
  overflow: hidden;
  padding: 34rpx 30rpx 30rpx;
  position: relative;
}

.recovery-hero::after {
  border: 26rpx solid rgba(240, 198, 108, 0.09);
  border-radius: 50%;
  content: "";
  height: 230rpx;
  position: absolute;
  right: -100rpx;
  top: -105rpx;
  width: 230rpx;
}

.hero-kicker { color: #f0cf87; font-size: 18rpx; font-weight: 800; letter-spacing: 3rpx; }
.hero-title { font-size: 42rpx; font-weight: 900; margin-top: 7rpx; }
.hero-copy { color: rgba(255,255,255,.68); font-size: 23rpx; line-height: 1.55; margin-top: 10rpx; }
.hero-stats { display: grid; gap: 12rpx; grid-template-columns: repeat(3, 1fr); margin-top: 27rpx; position: relative; z-index: 1; }
.hero-stat { background: rgba(255,255,255,.09); border: 1rpx solid rgba(255,255,255,.11); border-radius: 16rpx; color: rgba(255,255,255,.65); display: flex; flex-direction: column; font-size: 19rpx; padding: 16rpx; }
.stat-value { color: #fff; font-size: 31rpx; font-weight: 850; margin-bottom: 3rpx; }

.safe-note { align-items: flex-start; background: #fff9e9; border: 1rpx solid #eadbb8; border-radius: 18rpx; display: flex; gap: 14rpx; margin-top: 20rpx; padding: 19rpx; }
.safe-mark { align-items: center; background: #d5a43b; border-radius: 50%; color: #fff; display: flex; flex: 0 0 34rpx; font-size: 20rpx; font-weight: 850; height: 34rpx; justify-content: center; width: 34rpx; }
.safe-title { color: #654d18; font-size: 23rpx; font-weight: 850; }
.safe-copy { color: #86713e; font-size: 20rpx; line-height: 1.55; margin-top: 5rpx; }

.recovery-list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 22rpx; }
.recovery-card { background: #fff; border: 1rpx solid #e1e8e4; border-radius: 22rpx; box-shadow: 0 8rpx 26rpx rgba(25,62,50,.045); padding: 21rpx; }
.card-head { align-items: center; display: flex; gap: 16rpx; }
.goods-cover { background: #e8eeea; border-radius: 15rpx; flex: 0 0 92rpx; height: 92rpx; width: 92rpx; }
.goods-main { flex: 1; min-width: 0; }
.goods-title { color: #203f35; font-size: 27rpx; font-weight: 850; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.created-text { color: #929e98; font-size: 20rpx; margin-top: 9rpx; }
.status-pill { background: #e8f3ed; border-radius: 999rpx; color: #267052; flex: 0 0 auto; font-size: 20rpx; font-weight: 750; padding: 9rpx 14rpx; }
.progress-tip { background: #f3f7f4; border-radius: 13rpx; color: #63766d; font-size: 21rpx; line-height: 1.5; margin-top: 17rpx; padding: 14rpx 16rpx; }
.amount-panel { border-bottom: 1rpx solid #edf1ee; border-top: 1rpx solid #edf1ee; margin-top: 17rpx; padding: 10rpx 0; }
.amount-item { color: #718078; display: flex; font-size: 22rpx; justify-content: space-between; padding: 7rpx 2rpx; }
.amount-item.net { color: #173f33; font-size: 26rpx; font-weight: 850; }
.claim-row { align-items: center; display: flex; justify-content: space-between; margin-top: 17rpx; }
.claim-label { color: #929e98; font-size: 19rpx; }
.claim-status { color: #66756e; font-size: 23rpx; font-weight: 800; margin-top: 4rpx; }
.claim-status.attention { color: #a66f10; }
.claim-status.success { color: #17744d; }
.claim-status.danger { color: #b5473c; }
.claim-amount { color: #b66c2e; font-size: 29rpx; font-weight: 900; }
.claim-btn { background: #174c3b; border-radius: 16rpx; color: #fff; font-size: 25rpx; font-weight: 850; height: 76rpx; line-height: 76rpx; margin: 18rpx 0 0; width: 100%; }
.claim-btn.secondary { background: #e8f2ed; color: #24684c; }
.empty-state { align-items: center; color: #8a9892; display: flex; flex-direction: column; padding: 120rpx 28rpx; text-align: center; }
.empty-mark { align-items: center; background: #e5f0ea; border-radius: 24rpx; color: #267052; display: flex; font-size: 29rpx; font-weight: 900; height: 88rpx; justify-content: center; width: 88rpx; }
.empty-title { color: #27483c; font-size: 29rpx; font-weight: 850; margin-top: 20rpx; }
.empty-copy { font-size: 22rpx; line-height: 1.55; margin-top: 8rpx; }
.market-btn { background: #174c3b; border-radius: 999rpx; color: #fff; font-size: 23rpx; font-weight: 750; margin-top: 25rpx; padding: 17rpx 30rpx; }
