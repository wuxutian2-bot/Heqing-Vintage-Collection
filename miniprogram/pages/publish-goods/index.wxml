<view class="page publish-page">
  <view class="publish-note">
    <view class="note-title">发布到校园闲置市场</view>
    <view class="note-desc">个人发布支持平台担保交易，发布后也可在商品详情申请平台回收。请勿在公开描述中填写手机号、微信号等联系方式。</view>
  </view>

  <view class="field">
    <text class="field-label">商品标题</text>
    <input class="input" value="{{title}}" maxlength="30" placeholder="例如：九成新 Kindle Paperwhite" data-field="title" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="field-label">价格</text>
    <input class="input" value="{{price}}" type="digit" placeholder="出售价格；求购时填写预算" data-field="price" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="field-label">分类</text>
    <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="picker-value">{{categories[categoryIndex]}}</view>
    </picker>
  </view>
  <view class="field">
    <text class="field-label">商品描述</text>
    <textarea class="textarea" value="{{desc}}" maxlength="500" placeholder="成色、购买时间、配件、交易地点等" data-field="desc" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="image-field-title">
      <text class="field-label">商品图片</text>
      <text class="image-required">必填 · 至少1张</text>
    </view>
    <view class="image-grid">
      <view wx:for="{{images}}" wx:key="*this" class="image-cell">
        <image class="upload-image" mode="aspectFill" src="{{item}}"></image>
        <view class="remove-image" data-index="{{index}}" bindtap="removeImage">×</view>
      </view>
      <view wx:if="{{images.length < 9}}" class="add-image" bindtap="chooseImages">+</view>
    </view>
  </view>

  <button class="primary-btn submit-btn" loading="{{submitting}}" bindtap="submit">发布商品</button>
</view>
