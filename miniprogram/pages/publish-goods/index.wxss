.image-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(3, 1fr);
}

.image-field-title {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.image-required {
  color: #c4493d;
  font-size: 22rpx;
  font-weight: 650;
}

.image-cell,
.add-image,
.upload-image {
  border-radius: 8rpx;
  height: 190rpx;
  width: 100%;
}

.image-cell {
  position: relative;
}

.upload-image {
  background: #e5ece9;
}

.add-image {
  align-items: center;
  background: #eef5f2;
  color: #1f7a5a;
  display: flex;
  font-size: 62rpx;
  justify-content: center;
}

.remove-image {
  align-items: center;
  background: rgba(31, 41, 51, 0.72);
  border-radius: 50%;
  color: #fff;
  display: flex;
  height: 42rpx;
  justify-content: center;
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 42rpx;
}

.submit-btn {
  margin-top: 28rpx;
}
.publish-note {
  background: #edf6f1;
  border-left: 6rpx solid #16784b;
  margin-bottom: 20rpx;
  padding: 22rpx;
}

.note-title {
  font-size: 30rpx;
  font-weight: 750;
}

.note-desc {
  color: #4b6658;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}
