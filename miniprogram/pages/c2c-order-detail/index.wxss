.detail-page { background: #f3f6f4; color: #193f34; min-height: 100vh; padding: 20rpx 22rpx 176rpx; }.status-card { background: linear-gradient(135deg,#183f34,#237052); border-radius: 23rpx; color:#fff; padding:30rpx 27rpx; }.status-card.attention { background:linear-gradient(135deg,#665020,#9b7325); }.status-card.muted { background:linear-gradient(135deg,#526159,#72827a); }.status-label { color:rgba(255,255,255,.6); font-size:17rpx; font-weight:800; letter-spacing:2rpx; }.status-title { font-size:38rpx; font-weight:900; margin-top:8rpx; }.status-desc,.expire { color:rgba(255,255,255,.78); font-size:22rpx; line-height:1.55; margin-top:10rpx; }.expire { color:#ffe2a2; }.goods-card,.info-card { background:#fff; border:1rpx solid #e1e8e4; border-radius:21rpx; box-shadow:0 8rpx 24rpx rgba(29,66,53,.04); margin-top:18rpx; }.goods-card { align-items:center; display:flex; gap:16rpx; padding:20rpx; }.cover { background:#e8eeea; border-radius:15rpx; flex:0 0 120rpx; height:120rpx; width:120rpx; }.goods-main { flex:1; min-width:0; }.role-chip { color:#287153; font-size:18rpx; font-weight:800; }.goods-title { color:#203f35; font-size:28rpx; font-weight:850; margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.goods-desc { color:#87938d; font-size:20rpx; margin-top:8rpx; }.price { color:#c45141; font-size:30rpx; font-weight:900; }.info-card { padding:24rpx; }.section-title { color:#203f35; font-size:28rpx; font-weight:850; }.copy,.note { color:#607269; font-size:23rpx; line-height:1.65; margin-top:14rpx; }.note,.security { background:#eef7f1; border-radius:12rpx; color:#426c59; padding:13rpx 15rpx; }.row { color:#65756e; display:flex; font-size:24rpx; justify-content:space-between; padding:8rpx 0; }.row.total { border-top:1rpx solid #edf1ef; color:#193f34; font-size:28rpx; font-weight:900; margin-top:10rpx; padding-top:18rpx; }.security { font-size:20rpx; line-height:1.55; margin-top:14rpx; }.meta { color:#738078; font-size:22rpx; line-height:1.85; }.bottom-actions { background:rgba(255,255,255,.97); border-top:1rpx solid #e1e7e3; bottom:0; box-shadow:0 -8rpx 28rpx rgba(28,63,51,.06); display:flex; gap:12rpx; left:0; padding:16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); position:fixed; right:0; z-index:20; }.bottom-actions button { flex:1; min-width:0; }.primary,.ghost,.dispute { border-radius:16rpx; font-size:24rpx; font-weight:850; height:78rpx; line-height:78rpx; }.primary { background:#174c3b; color:#fff; }.ghost { background:#e8f2ed; color:#28684e; }.dispute { background:#fff2ef; color:#b5473c; flex:0 0 112rpx!important; }.empty { color:#87948e; padding:210rpx 30rpx; text-align:center; }
