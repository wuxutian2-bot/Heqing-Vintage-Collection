<view class="page forum-page">
  <view class="forum-hero">
    <image class="hero-map-image" mode="aspectFill" src="/images/forum/campus-map-hero.jpg"></image>
    <view class="hero-map-shade"></view>
    <view class="search-box">
      <image src="/images/forum/search.svg"></image>
      <input value="{{keyword}}" placeholder="搜索当前频道的标题、内容或用户" bindinput="onSearchInput" />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>
  </view>

  <view class="quick-panel">
    <view wx:for="{{quickChannels}}" wx:key="title" class="quick-item" data-category="{{item.category}}" data-action="{{item.action}}" bindtap="tapQuickChannel">
      <view class="quick-icon"><image mode="aspectFit" src="{{item.icon}}"></image></view>
      <view class="quick-title">{{item.title}}</view>
      <view class="quick-subtitle">{{item.subtitle}}</view>
    </view>
  </view>

  <view wx:if="{{weeklyHotPosts.length}}" class="hot-strip weekly-hot-strip">
    <view class="hot-badge"><text>热</text></view>
    <swiper class="weekly-hot-swiper" vertical="true" autoplay="{{weeklyHotAutoplay}}" interval="3500" duration="400" circular="true">
      <swiper-item wx:for="{{weeklyHotPosts}}" wx:key="_id" wx:for-item="item" wx:for-index="rank">
        <view class="weekly-hot-slide" data-id="{{item._id}}" bindtap="goWeeklyHotPost">
          <view class="hot-label"><text>本周热议</text><text class="hot-rank">TOP {{rank + 1}}</text></view>
          <view class="weekly-hot-title-row">
            <view class="hot-title">{{item.title}}</view>
            <text class="weekly-hot-views">{{item.viewCount || 0}}人看</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="weekly-ranking-link" catchtap="openWeeklyRanking"><text>榜单</text><text class="weekly-ranking-arrow">›</text></view>
  </view>
  <view wx:else class="hot-strip hot-empty" bindtap="goPublish">
    <view class="hot-badge"><text>新</text></view>
    <view class="hot-copy">
      <view class="hot-label">本周话题</view>
      <view class="hot-title">还没有热议，来聊聊校园新鲜事</view>
    </view>
    <view class="hot-count">去发布 <text>›</text></view>
  </view>

  <scroll-view class="category-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="category-track">
      <view wx:for="{{categories}}" wx:key="key" class="category-item {{activeCategory === item.key ? 'active' : ''}}" data-category="{{item.key}}" bindtap="selectCategory">{{item.text}}</view>
    </view>
  </scroll-view>

  <view class="feed-head">
    <view>
      <view class="feed-kicker">同学们正在聊</view>
      <view class="feed-title">{{activeCategoryText}}</view>
    </view>
    <view class="sort-switch">
      <view wx:for="{{sorts}}" wx:key="key" class="sort-item {{activeSort === item.key ? 'active' : ''}}" data-sort="{{item.key}}" bindtap="selectSort">{{item.text}}</view>
    </view>
  </view>

  <view wx:if="{{loading && !posts.length}}" class="feed-skeleton">
    <view class="skeleton-post"><view class="skeleton-avatar"></view><view class="skeleton-lines"><view></view><view></view><view></view></view></view>
    <view class="skeleton-post"><view class="skeleton-avatar"></view><view class="skeleton-lines"><view></view><view></view><view></view></view></view>
  </view>

  <view wx:elif="{{displayPosts.length}}" class="post-list">
    <view wx:for="{{displayPosts}}" wx:key="_id" class="post-card" data-id="{{item._id}}" bindtap="goDetail">
      <view class="author-row">
        <image class="author-avatar" mode="aspectFill" src="{{item.author.avatarUrl}}"></image>
        <view class="author-copy">
          <view class="author-name">{{item.author.displayName}}</view>
          <view class="author-time">{{item.createdText}} · 校内发布</view>
        </view>
        <view class="post-badges">
          <view wx:if="{{item.isPinned}}" class="feed-pinned-badge">置顶</view>
          <view class="category-badge">{{item.category}}</view>
        </view>
      </view>

      <view class="post-title">{{item.title}}</view>
      <view class="post-content">{{item.content}}</view>

      <view wx:if="{{item.previewImages.length}}" class="post-images image-count-{{item.previewImages.length}}">
        <image wx:for="{{item.previewImages}}" wx:for-item="picture" wx:key="*this" class="post-image" mode="aspectFill" src="{{picture}}"></image>
        <view wx:if="{{item.extraImageCount}}" class="extra-images">+{{item.extraImageCount}}</view>
      </view>

      <view class="post-meta">
        <view class="meta-item"><image src="/images/forum/eye.svg"></image><text>{{item.viewCount || 0}}</text></view>
        <view class="meta-item"><image src="/images/forum/comment.svg"></image><text>{{item.commentCount || 0}}</text></view>
        <view class="meta-item"><image src="/images/forum/heart.svg"></image><text>{{item.likeCount || 0}}</text></view>
        <view class="detail-link">查看讨论 <text>›</text></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{keyword}}" class="empty-panel">
    <view class="empty-mark">搜</view>
    <view class="empty-title">没有找到相关动态</view>
    <view class="empty-desc">试试更短的关键词，或切换其他频道</view>
    <button class="empty-action" bindtap="clearSearch">清除搜索</button>
  </view>

  <view wx:else class="empty-panel">
    <view class="empty-mark">聊</view>
    <view class="empty-title">这个频道还很安静</view>
    <view class="empty-desc">成为第一个发起校园讨论的人</view>
    <button class="empty-action" data-category="{{activeCategory}}" bindtap="goPublish">发布第一条动态</button>
  </view>

  <view wx:if="{{loading && posts.length}}" class="list-loading">正在加载更多...</view>
  <view wx:if="{{!hasMore && posts.length}}" class="list-end"><text></text>没有更多动态了<text></text></view>

  <button class="floating-publish" bindtap="goPublish"><text class="publish-plus">＋</text><text>发布</text></button>

  <view wx:if="{{showWeeklyRanking}}" class="ranking-mask" catchtap="closeWeeklyRanking">
    <view class="ranking-sheet" catchtap="stopRankingTap">
      <view class="ranking-head">
        <view>
          <view class="ranking-title">本周热议榜</view>
          <view class="ranking-subtitle">近7天 · 按浏览、评论和点赞综合排序</view>
        </view>
        <view class="ranking-close" catchtap="closeWeeklyRanking">×</view>
      </view>
      <scroll-view class="ranking-list" scroll-y="true">
        <view wx:for="{{weeklyHotPosts}}" wx:key="_id" wx:for-item="item" wx:for-index="rank" class="ranking-row" data-id="{{item._id}}" catchtap="goRankingPost">
          <view class="ranking-number">{{rank + 1}}</view>
          <view class="ranking-main">
            <view class="ranking-post-title">{{item.title}}</view>
            <view class="ranking-post-meta">{{item.viewCount || 0}} 浏览 · {{item.commentCount || 0}} 评论 · {{item.likeCount || 0}} 赞</view>
          </view>
          <text class="ranking-arrow">›</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
