.store-page {
  background: #f5f6f7;
  min-height: 100vh;
  padding-bottom: 116rpx;
}

.top-panel {
  background: #fff;
  border-bottom: 1rpx solid #e5e7eb;
  padding: 26rpx 24rpx 22rpx;
}

.brand-row {
  align-items: baseline;
  display: flex;
  gap: 18rpx;
}

.brand-name {
  color: #153f30;
  font-size: 38rpx;
  font-weight: 850;
  letter-spacing: -1rpx;
}

.brand-slogan {
  color: #728079;
  font-size: 23rpx;
}

.address-row {
  align-items: center;
  display: flex;
  margin-top: 24rpx;
}

.address-picker {
  display: block;
}

.address-pin {
  align-items: center;
  background: #e5f2eb;
  border-radius: 50%;
  color: #16784b;
  display: flex;
  font-size: 34rpx;
  height: 60rpx;
  justify-content: center;
  width: 60rpx;
}

.address-main {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.address-label {
  color: #84908b;
  font-size: 21rpx;
}

.address-text {
  color: #17211d;
  font-size: 31rpx;
  font-weight: 750;
  margin-top: 2rpx;
}

.address-helper {
  color: #7b8882;
  font-size: 20rpx;
  line-height: 1.4;
  margin-top: 5rpx;
}

.address-action {
  background: #eaf4ef;
  border-radius: 22rpx;
  color: #16784b;
  font-size: 21rpx;
  font-weight: 650;
  padding: 10rpx 16rpx;
  white-space: nowrap;
}

.address-arrow {
  color: #7e8984;
  font-size: 48rpx;
}

.search-row {
  align-items: center;
  background: #f3f5f4;
  border: 1rpx solid #e1e5e3;
  border-radius: 12rpx;
  display: flex;
  margin-top: 22rpx;
  min-height: 76rpx;
  padding-left: 22rpx;
}

.search-icon {
  color: #6c7772;
  font-size: 32rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1 1 auto;
  font-size: 27rpx;
  height: 70rpx;
  min-width: 0;
  width: 0;
}

.search-btn {
  background: #173f31;
  border-radius: 0 12rpx 12rpx 0;
  color: #fff;
  flex: 0 0 30%;
  font-size: 25rpx;
  height: 76rpx;
  line-height: 76rpx;
  max-width: 30%;
  min-width: 0;
  width: 30%;
}

.outlet-strip {
  align-items: center;
  background: #eaf4ef;
  color: #245a42;
  display: flex;
  font-size: 22rpx;
  justify-content: space-between;
  min-height: 56rpx;
  padding: 12rpx 24rpx;
}

.store-body {
  background: #fff;
  display: flex;
  height: calc(100vh - 420rpx);
  min-height: 640rpx;
}

.category-rail {
  background: #f2f4f3;
  flex: 0 0 190rpx;
  height: 100%;
  width: 190rpx;
}

.category-item {
  align-items: center;
  color: #68736e;
  display: flex;
  font-size: 25rpx;
  justify-content: center;
  line-height: 1.35;
  min-height: 104rpx;
  padding: 20rpx 14rpx;
  position: relative;
  text-align: center;
}

.category-item.active {
  background: #fff;
  color: #173f31;
  font-weight: 750;
}

.category-item.active::before {
  background: #16784b;
  content: "";
  height: 42rpx;
  left: 0;
  position: absolute;
  top: 31rpx;
  width: 6rpx;
}

.product-scroll {
  flex: 1;
  height: 100%;
  min-width: 0;
  padding: 0 20rpx calc(150rpx + env(safe-area-inset-bottom));
}

.list-heading {
  align-items: center;
  border-bottom: 1rpx solid #edf0ee;
  display: flex;
  font-size: 27rpx;
  font-weight: 750;
  justify-content: space-between;
  padding: 24rpx 0 18rpx;
}

.list-count {
  color: #8b9591;
  font-size: 21rpx;
  font-weight: 400;
}

.product-row {
  border-bottom: 1rpx solid #edf0ee;
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
}

.product-image {
  background: #f0f2f1;
  border-radius: 10rpx;
  flex: 0 0 154rpx;
  height: 154rpx;
  width: 154rpx;
}

.product-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.product-title {
  color: #202522;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
  max-height: 78rpx;
  overflow: hidden;
}

.product-stock {
  color: #78837e;
  font-size: 21rpx;
  margin-top: 8rpx;
}

.product-stock.sold-out {
  color: #b13d36;
}

.product-bottom {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  margin-top: auto;
}

.product-price {
  color: #e13e33;
  font-size: 34rpx;
  font-weight: 800;
}

.price-sign {
  font-size: 23rpx;
  margin-right: 3rpx;
}

.add-btn {
  align-items: center;
  background: #16784b;
  border-radius: 50%;
  color: #fff;
  display: flex;
  flex: 0 0 54rpx;
  font-size: 28rpx;
  height: 54rpx;
  justify-content: center;
  line-height: 54rpx;
  max-width: 54rpx;
  min-width: 54rpx;
  padding: 0;
  width: 54rpx;
}

.add-btn.disabled {
  background: #cbd2ce;
}

.product-empty {
  padding-top: 100rpx;
}

.empty-state {
  background: #fff;
  margin: 28rpx 24rpx;
  padding: 64rpx 36rpx;
  text-align: center;
}

.empty-mark {
  align-items: center;
  background: #e5f2eb;
  border-radius: 50%;
  color: #16784b;
  display: flex;
  font-size: 34rpx;
  font-weight: 800;
  height: 92rpx;
  justify-content: center;
  margin: 0 auto 24rpx;
  width: 92rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 750;
}

.empty-desc {
  color: #737e79;
  font-size: 24rpx;
  line-height: 1.5;
  margin: 14rpx 0 28rpx;
}

.setup-btn {
  margin: 0 auto;
  width: 300rpx;
}

.store-fab-row {
  align-items: center;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(27, 45, 37, 0.12);
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  height: 96rpx;
  left: 16rpx;
  padding: 0 20rpx;
  position: fixed;
  right: 16rpx;
  z-index: 12;
}

.admin-fab,
.cart-fab {
  align-items: center;
  background: transparent;
  border-radius: 0;
  color: #173f31;
  display: flex;
  flex: 1 1 0;
  font-size: 30rpx;
  font-weight: 650;
  gap: 14rpx;
  height: 96rpx;
  justify-content: center;
  line-height: 96rpx;
  margin: 0;
  max-width: none;
  min-width: 0;
  padding: 0;
  width: 0;
}

.admin-fab {
  color: #2b302e;
}

.cart-fab {
  color: #173f31;
}

.store-fab-icon {
  flex: 0 0 42rpx;
  height: 42rpx;
  width: 42rpx;
}

.store-fab-label {
  white-space: nowrap;
}

.store-fab-divider {
  background: #edf0ee;
  flex: 0 0 1rpx;
  height: 52rpx;
  width: 1rpx;
}

.cart-count {
  align-items: center;
  background: #1e5a43;
  border-radius: 18rpx;
  display: flex;
  color: #fff;
  flex: 0 0 auto;
  font-size: 21rpx;
  height: 40rpx;
  justify-content: center;
  min-width: 40rpx;
  padding: 0 10rpx;
}
