.messages-page {
  background: #fff;
}

.message-heading {
  font-size: 38rpx;
  font-weight: 750;
  margin-top: 12rpx;
}

.guest-message-card {
  align-items: center;
  background: linear-gradient(155deg, #eff8f3 0%, #ffffff 70%);
  border: 1rpx solid #dcebe3;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 50rpx rgba(20, 67, 48, .08);
  display: flex;
  flex-direction: column;
  margin-top: 32rpx;
  padding: 64rpx 44rpx 44rpx;
  text-align: center;
}

.guest-message-mark {
  align-items: center;
  background: #16784b;
  border-radius: 24rpx;
  color: #fff;
  display: flex;
  font-size: 42rpx;
  font-weight: 800;
  height: 96rpx;
  justify-content: center;
  width: 96rpx;
}

.guest-message-title {
  color: #173f31;
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 28rpx;
}

.guest-message-desc {
  color: #68766f;
  font-size: 25rpx;
  line-height: 1.65;
  margin-top: 16rpx;
  max-width: 520rpx;
}

.guest-message-button {
  background: #16784b;
  border-radius: 14rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  margin-top: 34rpx;
  width: 100%;
}

.guest-message-note {
  color: #8a9690;
  font-size: 21rpx;
  margin-top: 22rpx;
}

.conversation-list {
  margin-top: 8rpx;
}

.conversation-item {
  align-items: flex-start;
  border-bottom: 1rpx solid #edf0f2;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
}

.conversation-avatar {
  border-radius: 50%;
  height: 96rpx;
  width: 96rpx;
}

.conversation-main {
  flex: 1;
  min-width: 0;
}

.conversation-head,
.conversation-bottom {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.conversation-name {
  font-size: 29rpx;
  font-weight: 750;
}

.conversation-time {
  color: #9aa5b1;
  font-size: 21rpx;
}

.conversation-bottom {
  margin-top: 10rpx;
}

.last-message {
  color: #6b7280;
  flex: 1;
  font-size: 25rpx;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread {
  align-items: center;
  background: #d85a18;
  border-radius: 20rpx;
  color: #fff;
  display: flex;
  font-size: 20rpx;
  height: 36rpx;
  justify-content: center;
  min-width: 36rpx;
  padding: 0 8rpx;
}

.context-label {
  color: #16784b;
  font-size: 21rpx;
  margin-top: 9rpx;
}
